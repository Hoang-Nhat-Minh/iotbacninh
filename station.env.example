# =============================================================================
# FILE CẤU HÌNH MÔI TRƯỜNG DÀNH CHO MÁY TRẠM HIỆN TRƯỜNG (EDGE STATION CLIENT)
# Hướng dẫn:
#   1. Copy file này thành .env trên máy trạm: cp station.env.example .env
#   2. Điền thông tin IP Public, Cổng, User/Pass thật của VPS vào file .env
#   3. File .env đã được cấu hình trong .gitignore nên KHÔNG BAO GIỜ bị lộ lên GitHub
# =============================================================================

# 1. Định danh trạm
STATION_CODE=ST-PHUCHOA-01

# 2. Kết nối MQTT Broker trên VPS
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# 3. Kết nối Media Streaming Server (MediaMTX) trên VPS
MEDIA_SERVER_HOST=127.0.0.1
RTMP_PORT=1935
HLS_PORT=8888
WEBRTC_PORT=8889

# 4. URL API Laravel nhận ảnh Snapshot
MEDIA_API_URL=http://127.0.0.1:8000/api/iot/camera/image

# 5. Cấu hình 2 Camera IP trong mạng LAN Switch nội bộ của trạm
CAM1_IP=192.168.1.101
CAM1_RTSP=rtsp://admin:password@192.168.1.101:554/stream1
CAM1_SUB_RTSP=rtsp://admin:password@192.168.1.101:554/stream2

CAM2_IP=192.168.1.102
CAM2_RTSP=rtsp://admin:password@192.168.1.102:554/stream1
CAM2_SUB_RTSP=rtsp://admin:password@192.168.1.102:554/stream2
